# Copia este archivo a .env para desarrollo local. En Railway, define estas
# variables en el servicio. Nunca subas credenciales al repositorio.

# Conexión a TiDB Cloud (o cualquier MySQL compatible)
DATABASE_URL=mysql://usuario:contrasena@host:4000/ferez
# Alternativa: DB_HOST, DB_PORT, DB_USUARIO, DB_PASSWORD, DB_NOMBRE
# DB_SSL=off   # solo para base local sin TLS

# Panel de administración
ADMIN_USUARIO=
ADMIN_PASSWORD=

# Bot de WhatsApp (Cloud API de Meta) — hoy número de prueba; la línea real
# será solo cambiar estos valores.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# SITIO_URL=https://ferez.mx
